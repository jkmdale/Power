# ---------------------------------------------------------------------------
# Power — home energy dashboard configuration
# Copy to `.env` (which is git-ignored) and edit. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Database (TimescaleDB) ---------------------------------------------------
# These defaults match docker-compose.yml. The ingester and Grafana both use them.
POSTGRES_DB=energy
POSTGRES_USER=energy
POSTGRES_PASSWORD=energy
# Connection string the ingester uses. Host is the compose service name.
DATABASE_URL=postgresql://energy:energy@timescaledb:5432/energy

# --- Ingester: which data source to pull from --------------------------------
# One of: simulator | shelly_http | shelly_mqtt | emporia
# `simulator` needs NO hardware and is the default so the stack works out of the box.
SOURCE=simulator

# How often poll-based sources read, in seconds (ignored by shelly_mqtt).
POLL_INTERVAL=2

# Logical name stored against every reading. Use a distinct id per physical device.
DEVICE_ID=sim-board

# --- Shelly (local API) — used when SOURCE=shelly_http or shelly_mqtt ----------
# IP / hostname of the Shelly Pro 3EM on your LAN (give it a static DHCP lease).
SHELLY_HOST=192.168.1.50
# Optional device auth (Settings -> Authentication in the Shelly web UI).
SHELLY_USER=admin
SHELLY_PASSWORD=

# MQTT broker (used when SOURCE=shelly_mqtt). Point the Shelly at this broker.
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
# Shelly publishes under this topic prefix (Settings -> MQTT -> "MQTT Prefix").
MQTT_TOPIC_PREFIX=shellypro3em

# --- Emporia (cloud, unofficial) — used when SOURCE=emporia -------------------
# These are your Emporia app credentials. Treat them as sensitive.
EMPORIA_EMAIL=
EMPORIA_PASSWORD=
# Emporia's cloud only updates ~once/minute; don't poll faster than this.
EMPORIA_POLL_INTERVAL=60
